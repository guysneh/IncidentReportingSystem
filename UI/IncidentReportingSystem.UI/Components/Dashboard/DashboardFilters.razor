@using System.Globalization
@using MudBlazor
@using IncidentReportingSystem.UI.Core.Dashboard
@inject IAppTexts T

@if (CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft)
{
    <div dir="rtl">
        <MudPaper Class="pa-3 d-flex flex-wrap gap-3 align-center">
            <MudDateRangePicker @bind-DateRange="_range"
                                Label="@T["Filters.DateRange"]"
                                Dense="true"
                                Variant="Variant.Outlined"
                                ShrinkLabel="true"
                                Adornment="Adornment.End"
                                Class="drp-rtl-fix" />

            <MudSelect T="TimeResolution" @bind-Value="_resolution" Label="@T["Filters.Period"]" Dense="true" Style="width:160px">
                <MudSelectItem Value="TimeResolution.Daily">@T["Period.Daily"]</MudSelectItem>
                <MudSelectItem Value="TimeResolution.Weekly">@T["Period.Weekly"]</MudSelectItem>
            </MudSelect>

            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Apply">@T["Filters.Apply"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Reset">@T["Filters.Reset"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="ExportCsv" StartIcon="@Icons.Material.Filled.Download">
                @T["Export.CSV"]
            </MudButton>
        </MudPaper>
    </div>
}
else
{
    <MudPaper Class="pa-3 d-flex flex-wrap gap-3 align-center">
        <MudDateRangePicker @bind-DateRange="_range"
                            Label="@T["Filters.DateRange"]"
                            Dense="true"
                            Variant="Variant.Outlined"
                            ShrinkLabel="true"
                            Adornment="Adornment.Start" />

        <MudSelect T="TimeResolution" @bind-Value="_resolution" Label="@T["Filters.Period"]" Dense="true" Style="width:160px">
            <MudSelectItem Value="TimeResolution.Daily">@T["Period.Daily"]</MudSelectItem>
            <MudSelectItem Value="TimeResolution.Weekly">@T["Period.Weekly"]</MudSelectItem>
        </MudSelect>

        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Apply">@T["Filters.Apply"]</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Reset">@T["Filters.Reset"]</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="ExportCsv" StartIcon="@Icons.Material.Filled.Download">
            @T["Export.CSV"]
        </MudButton>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public DashboardQuery Query { get; set; } = new();
    [Parameter, EditorRequired] public EventCallback<DashboardQuery> OnApply { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }

    private DateRange? _range;
    private TimeResolution _resolution;

    protected override void OnParametersSet()
    {
        _resolution = Query.Resolution;
        _range = new DateRange(
            Query.From.HasValue ? Query.From.Value.ToDateTime(TimeOnly.MinValue) : (DateTime?)null,
            Query.To.HasValue ? Query.To.Value.ToDateTime(TimeOnly.MinValue) : (DateTime?)null
        );
    }

    private Task Apply()
    {
        DateOnly? from = _range?.Start.HasValue == true ? DateOnly.FromDateTime(_range!.Start!.Value.Date) : null;
        DateOnly? to = _range?.End.HasValue == true ? DateOnly.FromDateTime(_range!.End!.Value.Date) : null;
        return OnApply.InvokeAsync(new DashboardQuery(from, to, _resolution));
    }

    private Task Reset()
    {
        _range = null; _resolution = TimeResolution.Daily;
        return OnApply.InvokeAsync(new DashboardQuery(null, null, _resolution));
    }

    private Task ExportCsv() => OnExport.InvokeAsync();
}
