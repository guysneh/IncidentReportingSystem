@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Nav
@inject IncidentReportingSystem.UI.Core.Auth.IAuthService Auth
@inject Microsoft.Extensions.Logging.ILogger<App> Logger

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(IncidentReportingSystem.UI.Shared.MainLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(IncidentReportingSystem.UI.Shared.MainLayout)">
            <!-- Optional: NotFound content -->
        </LayoutView>
    </NotFound>
</Router>
